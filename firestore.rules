rules_version = '2';

// ============================================================
//  Alloma AI – Firestore Security Rules
//  Last updated: 2026-02-24
//  Author: Firebase Security Expert (Antigravity)
// ============================================================
//
//  SECURITY MODEL OVERVIEW
//  ───────────────────────
//  • isSignedIn()   – caller must be authenticated
//  • isOwner(uid)   – caller UID matches the document owner
//  • isAdmin()      – caller email is in the allow-list  OR
//                     their /users/{uid} document has role == 'admin'
//
//  DEFAULT behaviour for any path NOT explicitly matched:
//  → allow: false  (deny-by-default)
//
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────
    //  HELPER FUNCTIONS
    // ──────────────────────────────────────────────────────

    /// Returns true when the request has valid auth credentials.
    function isSignedIn() {
      return request.auth != null;
    }

    /// Returns true when the authenticated UID equals the given uid.
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /// Returns true when the current user is an administrator.
    /// Two checks are combined with OR so either path grants access:
    ///   1. Email is in the hard-coded allow-list (fast, no extra read).
    ///   2. The user's Firestore profile document has role == 'admin'
    ///      (allows granting/revoking admin without a code deploy).
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'admin@alloma.ai',
          'mansurxonpersonal@gmail.com',
          'mansurxon.gemini@gmail.com'
        ]
        ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // ──────────────────────────────────────────────────────
    //  DATA VALIDATION HELPERS
    // ──────────────────────────────────────────────────────

    /// Validates that a new blog/subject/topic/method document
    /// contains the minimum required fields.
    function hasRequiredContentFields() {
      return request.resource.data.keys().hasAll(['title', 'createdAt']);
    }

    /// Validates that a new ticket has the minimum required fields.
    function hasRequiredTicketFields() {
      return request.resource.data.keys().hasAll(['subject', 'userId', 'createdAt', 'status']);
    }

    /// Validates that a new notification has the minimum required fields.
    function hasRequiredNotificationFields() {
      return request.resource.data.keys().hasAll(['title', 'body', 'createdAt', 'target', 'type']);
    }

    /// Validates that a new activity log has the minimum required fields.
    function hasRequiredActivityFields() {
      return request.resource.data.keys().hasAll(['userId', 'type', 'timestamp']);
    }

    /// Validates that a new task document has the minimum required fields.
    function hasRequiredTaskFields() {
      return request.resource.data.keys().hasAll(['userId', 'title', 'createdAt', 'status']);
    }

    // ══════════════════════════════════════════════════════
    //  COLLECTION RULES
    // ══════════════════════════════════════════════════════

    // ──────────────────────────────────────────────────────
    //  /users/{userId}
    //  • Read: any authenticated user (needed for leaderboard queries)
    //  • Write: owner only (or admin)
    //  • Admin can perform any operation on any user document.
    // ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isSignedIn();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────
    //  /blogs/{blogId}
    //  • Read: anyone (even unauthenticated – public content)
    //  • Write: admin only, with required-field validation
    // ──────────────────────────────────────────────────────
    match /blogs/{blogId} {
      allow read: if true;
      allow create: if isAdmin() && hasRequiredContentFields();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────
    //  /subjects/{subjectId}
    //  • Read: any authenticated user
    //  • Write: admin only, with required-field validation
    // ──────────────────────────────────────────────────────
    match /subjects/{subjectId} {
      allow read: if true;
      allow create: if isAdmin() && hasRequiredContentFields();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // /subjects/{subjectId}/topics/{topicId}
      // Sub-collection inherits the same access pattern as the parent.
      match /topics/{topicId} {
        allow read: if true;
        allow create: if isAdmin() && hasRequiredContentFields();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ──────────────────────────────────────────────────────
    //  /topics/{topicId}  (top-level, if used separately)
    //  • Read: public
    //  • Write: admin only
    // ──────────────────────────────────────────────────────
    match /topics/{topicId} {
      allow read: if true;
      allow create: if isAdmin() && hasRequiredContentFields();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────
    //  /methods/{methodId}
    //  • Read: any authenticated user
    //  • Write: admin only, with required-field validation
    // ──────────────────────────────────────────────────────
    match /methods/{methodId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // /methods/{methodId}/methodTopics/{topicId}
      match /methodTopics/{topicId} {
        allow read: if true;
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ──────────────────────────────────────────────────────
    //  /methodTopics/{topicId}  (top-level, if used separately)
    //  • Read: public
    //  • Write: admin only
    // ──────────────────────────────────────────────────────
    match /methodTopics/{topicId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────
    //  /tickets/{ticketId}
    //  • Users can create their own ticket (userId field must
    //    match auth.uid – prevents impersonation).
    //  • Users can read/update ONLY their own tickets.
    //  • Admins can read/write ALL tickets.
    //
    //  /tickets/{ticketId}/messages/{messageId}  (sub-collection)
    //  • The ticket owner or admin can read messages.
    //  • The ticket owner can add new messages (sender = 'user').
    //  • Admins can add messages (sender = 'admin') and update any.
    // ──────────────────────────────────────────────────────
    match /tickets/{ticketId} {
      allow read:   if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && hasRequiredTicketFields();
      allow update: if isAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin()
                    || (isSignedIn()
                        && get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid);

        // Ticket owner sends a message as 'user'; admin sends as 'admin'.
        allow create: if isSignedIn() && (
          // Regular user: must own the ticket and identify as 'user' sender
          (
            get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid
            && request.resource.data.sender == 'user'
            && request.resource.data.keys().hasAll(['sender', 'text', 'createdAt'])
          )
          ||
          // Admin: can send with sender = 'admin'
          isAdmin()
        );
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ──────────────────────────────────────────────────────
    //  /activities/{activityId}
    //  • Users can create activity logs for THEMSELVES only.
    //  • Admins can read ALL activity logs.
    //  • Nobody (not even admins) should update or delete logs
    //    to ensure audit trail integrity.
    // ──────────────────────────────────────────────────────
    match /activities/{activityId} {
      allow read:   if isAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && hasRequiredActivityFields();
      // Intentionally no update/delete – preserves audit trail.
      allow update: if false;
      allow delete: if isAdmin(); // Admin-only purge if truly needed
    }

    // ──────────────────────────────────────────────────────
    //  /notifications/{notificationId}
    //  • Read: any authenticated user (targeted or broadcast).
    //  • Write: admin only, with required-field validation.
    // ──────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && hasRequiredNotificationFields();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────
    //  /tasks/{taskId}
    //  • Users can only access their own tasks.
    //  • Admins can read/write all tasks.
    // ──────────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read:   if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && hasRequiredTaskFields();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ──────────────────────────────────────────────────────
    //  /chats/{chatId}
    //  • Users can read/write their own chat histories.
    //  • Admins can read all chats.
    // ──────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read:   if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ──────────────────────────────────────────────────────
    //  /questions/{questionId}  (legacy collection)
    //  • Read:  authenticated users only
    //  • Write: admin only
    // ──────────────────────────────────────────────────────
    match /questions/{questionId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ──────────────────────────────────────────────────────
    //  /caseSubjects/{subjectId}  (fan bo'limlari)
    //  • Read:  public (unauthenticated ok – landing page)
    //  • Write: admin only
    // ──────────────────────────────────────────────────────
    match /caseSubjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ──────────────────────────────────────────────────────
    //  /cases/{caseId}
    //  • Read:  authenticated users (solution visibility
    //           is enforced client-side, not in rules)
    //  • Write: admin only
    //
    //  /cases/{caseId}/questions/{qId}
    //  • Read:  authenticated users
    //  • Write: admin only
    // ──────────────────────────────────────────────────────
    match /cases/{caseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /questions/{qId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // ──────────────────────────────────────────────────────
    //  DENY-BY-DEFAULT FALLBACK
    //  Any path not explicitly matched above is DENIED.
    //  This is the default Firestore behaviour when no rule
    //  matches, but declaring it explicitly documents intent.
    // ──────────────────────────────────────────────────────
    // (Firestore implicitly denies all unmatched paths)

  }
}
